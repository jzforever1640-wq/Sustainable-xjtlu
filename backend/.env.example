# PostgreSQL connection
# For Render, set DATABASE_URL to its internal PostgreSQL connection string.
# When DATABASE_URL is present, DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD are ignored.
# DATABASE_URL=postgresql://user:password@host:5432/database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sustainable_xjtlu
DB_USER=sustainable_xjtlu
DB_PASSWORD=change-me

# Generate long, unique values for non-local environments.
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
